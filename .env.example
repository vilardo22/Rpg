# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API Keys). Nunca commite o .env.local.

# Públicas: vão para o navegador. A segurança vem das políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRETA: só no servidor (cadastro e seed). Nunca use em código "use client",
# nunca commite e nunca cole no chat. Usada a partir da Fase 1.
SUPABASE_SECRET_KEY=sb_secret_...
